# Required: Claude API for safety analysis + default optimizer
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Daytona: sandbox for dynamic safety analysis
DAYTONA_API_KEY=your-daytona-api-key-here
DAYTONA_BASE_URL=https://app.daytona.io/api

# OpenRouter: multi-model optimization (--optimizer openrouter:<model>)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
